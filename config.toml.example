[auth]
# OAuth 1.0a credentials. In X Developer Console these are shown as:
# Consumer Key (API Key), Consumer Secret (API Key Secret),
# Access Token, and Access Token Secret.
consumer_key = ""
consumer_secret = ""
access_token = ""
access_token_secret = ""

[source]
username = "source_account"
# Optional: setting this avoids the username lookup on every run.
user_id = ""

[target]
username = "target_account"
# Post text template. Supported date tokens are yyyy, mm, and dd.
post_text = "yyyy.mm.dd Daily update"

[matching]
keyword_1 = "keyword_one"
keyword_2 = "keyword_two"

[system]
timezone = "Asia/Tokyo"
state_file = "state.json"
api_base_url = "https://api.x.com"
dry_run = false
